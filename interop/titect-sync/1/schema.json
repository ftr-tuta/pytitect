{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "titect-sync/1 document",
  "oneOf": [
    { "$ref": "#/$defs/sessionDocument" },
    { "$ref": "#/$defs/datasetDocument" },
    { "$ref": "#/$defs/bootstrapRequestDocument" },
    { "$ref": "#/$defs/bootstrapResponseDocument" },
    { "$ref": "#/$defs/snapshotDocument" },
    { "$ref": "#/$defs/deltaDocument" },
    { "$ref": "#/$defs/resetDocument" },
    { "$ref": "#/$defs/generationMismatchDocument" },
    { "$ref": "#/$defs/readinessDocument" },
    { "$ref": "#/$defs/mutationOutcomeDocument" },
    { "$ref": "#/$defs/mutationOutcomesDocument" }
  ],
  "$defs": {
    "opaqueId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "created_at", "expires_at"],
      "properties": {
        "session_id": { "$ref": "#/$defs/opaqueId" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "generation", "modes"],
      "properties": {
        "dataset_id": { "$ref": "#/$defs/opaqueId" },
        "generation": { "type": "integer", "minimum": 0 },
        "modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["snapshot", "delta"] }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_document_bytes",
        "max_datasets",
        "max_items_per_page",
        "max_mutations",
        "max_opaque_id_bytes",
        "max_capabilities"
      ],
      "properties": {
        "max_document_bytes": { "type": "integer", "minimum": 1 },
        "max_datasets": { "type": "integer", "minimum": 1 },
        "max_items_per_page": { "type": "integer", "minimum": 1 },
        "max_mutations": { "type": "integer", "minimum": 1 },
        "max_opaque_id_bytes": { "type": "integer", "minimum": 1 },
        "max_capabilities": { "type": "integer", "minimum": 1 }
      }
    },
    "upsert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "revision", "value"],
      "properties": {
        "item_id": { "$ref": "#/$defs/opaqueId" },
        "revision": { "type": "integer", "minimum": 0 },
        "value": true
      }
    },
    "tombstone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "revision", "deleted_at"],
      "properties": {
        "item_id": { "$ref": "#/$defs/opaqueId" },
        "revision": { "type": "integer", "minimum": 0 },
        "deleted_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest", "item_count"],
      "properties": {
        "algorithm": { "const": "sha-256" },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "item_count": { "type": "integer", "minimum": 0 }
      }
    },
    "sessionPayload": { "$ref": "#/$defs/session" },
    "datasetPayload": { "$ref": "#/$defs/dataset" },
    "bootstrapRequestPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_id", "dataset_ids", "capabilities"],
      "properties": {
        "client_id": { "$ref": "#/$defs/opaqueId" },
        "dataset_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/opaqueId" }
        },
        "capabilities": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      }
    },
    "bootstrapResponsePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session", "datasets", "limits"],
      "properties": {
        "session": { "$ref": "#/$defs/session" },
        "datasets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/dataset" }
        },
        "limits": { "$ref": "#/$defs/limits" }
      }
    },
    "snapshotPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "generation", "upserts", "next_cursor", "integrity"],
      "properties": {
        "dataset_id": { "$ref": "#/$defs/opaqueId" },
        "generation": { "type": "integer", "minimum": 0 },
        "upserts": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/upsert" }
        },
        "next_cursor": { "oneOf": [{ "$ref": "#/$defs/opaqueId" }, { "type": "null" }] },
        "integrity": { "$ref": "#/$defs/integrity" }
      }
    },
    "deltaPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id",
        "generation",
        "upserts",
        "tombstones",
        "next_cursor",
        "integrity"
      ],
      "properties": {
        "dataset_id": { "$ref": "#/$defs/opaqueId" },
        "generation": { "type": "integer", "minimum": 0 },
        "upserts": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/upsert" }
        },
        "tombstones": {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/tombstone" }
        },
        "next_cursor": { "oneOf": [{ "$ref": "#/$defs/opaqueId" }, { "type": "null" }] },
        "integrity": { "$ref": "#/$defs/integrity" }
      }
    },
    "resetPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "generation", "reason"],
      "properties": {
        "dataset_id": { "$ref": "#/$defs/opaqueId" },
        "generation": { "type": "integer", "minimum": 0 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "generationMismatchPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "expected", "actual"],
      "properties": {
        "dataset_id": { "$ref": "#/$defs/opaqueId" },
        "expected": { "type": "integer", "minimum": 0 },
        "actual": { "type": "integer", "minimum": 0 }
      }
    },
    "readinessPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready", "checked_at", "reason", "retry_after_ms"],
      "properties": {
        "ready": { "type": "boolean" },
        "checked_at": { "$ref": "#/$defs/timestamp" },
        "reason": { "type": ["string", "null"], "maxLength": 1024 },
        "retry_after_ms": { "type": ["integer", "null"], "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "ready": { "const": true } } },
          "then": {
            "properties": {
              "reason": { "type": "null" },
              "retry_after_ms": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "reason": { "type": "string", "minLength": 1 },
              "retry_after_ms": { "type": ["integer", "null"], "minimum": 0 }
            }
          }
        }
      ]
    },
    "mutationOutcomePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutation_id", "state", "revision", "receipt_id", "reason"],
      "properties": {
        "mutation_id": { "$ref": "#/$defs/opaqueId" },
        "state": { "enum": ["applied", "rejected", "conflict", "uncertain"] },
        "revision": { "type": ["integer", "null"], "minimum": 0 },
        "receipt_id": { "oneOf": [{ "$ref": "#/$defs/opaqueId" }, { "type": "null" }] },
        "reason": { "type": ["string", "null"], "maxLength": 1024 }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "applied" } } },
          "then": {
            "properties": {
              "revision": { "type": "integer", "minimum": 0 },
              "reason": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "revision": { "type": "null" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "mutationOutcomesPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "generation", "outcomes"],
      "properties": {
        "dataset_id": { "$ref": "#/$defs/opaqueId" },
        "generation": { "type": "integer", "minimum": 0 },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/mutationOutcomePayload" }
        }
      }
    },
    "sessionDocument": {
      "$ref": "#/$defs/envelopeSession"
    },
    "datasetDocument": {
      "$ref": "#/$defs/envelopeDataset"
    },
    "bootstrapRequestDocument": {
      "$ref": "#/$defs/envelopeBootstrapRequest"
    },
    "bootstrapResponseDocument": {
      "$ref": "#/$defs/envelopeBootstrapResponse"
    },
    "snapshotDocument": { "$ref": "#/$defs/envelopeSnapshot" },
    "deltaDocument": { "$ref": "#/$defs/envelopeDelta" },
    "resetDocument": { "$ref": "#/$defs/envelopeReset" },
    "generationMismatchDocument": { "$ref": "#/$defs/envelopeGenerationMismatch" },
    "readinessDocument": { "$ref": "#/$defs/envelopeReadiness" },
    "mutationOutcomeDocument": { "$ref": "#/$defs/envelopeMutationOutcome" },
    "mutationOutcomesDocument": { "$ref": "#/$defs/envelopeMutationOutcomes" },
    "envelopeSession": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "kind", "payload"],
      "properties": { "protocol": { "const": "titect-sync/1" }, "kind": { "const": "session" }, "payload": { "$ref": "#/$defs/sessionPayload" } }
    },
    "envelopeDataset": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "kind", "payload"],
      "properties": { "protocol": { "const": "titect-sync/1" }, "kind": { "const": "dataset" }, "payload": { "$ref": "#/$defs/datasetPayload" } }
    },
    "envelopeBootstrapRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "kind", "payload"],
      "properties": { "protocol": { "const": "titect-sync/1" }, "kind": { "const": "bootstrap_request" }, "payload": { "$ref": "#/$defs/bootstrapRequestPayload" } }
    },
    "envelopeBootstrapResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "kind", "payload"],
      "properties": { "protocol": { "const": "titect-sync/1" }, "kind": { "const": "bootstrap_response" }, "payload": { "$ref": "#/$defs/bootstrapResponsePayload" } }
    },
    "envelopeSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "kind", "payload"],
      "properties": { "protocol": { "const": "titect-sync/1" }, "kind": { "const": "snapshot" }, "payload": { "$ref": "#/$defs/snapshotPayload" } }
    },
    "envelopeDelta": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "kind", "payload"],
      "properties": { "protocol": { "const": "titect-sync/1" }, "kind": { "const": "delta" }, "payload": { "$ref": "#/$defs/deltaPayload" } }
    },
    "envelopeReset": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "kind", "payload"],
      "properties": { "protocol": { "const": "titect-sync/1" }, "kind": { "const": "reset_required" }, "payload": { "$ref": "#/$defs/resetPayload" } }
    },
    "envelopeGenerationMismatch": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "kind", "payload"],
      "properties": { "protocol": { "const": "titect-sync/1" }, "kind": { "const": "generation_mismatch" }, "payload": { "$ref": "#/$defs/generationMismatchPayload" } }
    },
    "envelopeReadiness": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "kind", "payload"],
      "properties": { "protocol": { "const": "titect-sync/1" }, "kind": { "const": "readiness" }, "payload": { "$ref": "#/$defs/readinessPayload" } }
    },
    "envelopeMutationOutcome": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "kind", "payload"],
      "properties": { "protocol": { "const": "titect-sync/1" }, "kind": { "const": "mutation_outcome" }, "payload": { "$ref": "#/$defs/mutationOutcomePayload" } }
    },
    "envelopeMutationOutcomes": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "kind", "payload"],
      "properties": { "protocol": { "const": "titect-sync/1" }, "kind": { "const": "mutation_outcomes" }, "payload": { "$ref": "#/$defs/mutationOutcomesPayload" } }
    }
  }
}
