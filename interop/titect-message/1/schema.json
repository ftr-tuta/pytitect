{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pytitect:titect-message:1",
  "title": "titect-message/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source", "specversion", "type", "subject", "time", "dataschema", "datacontenttype", "profile", "data"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "specversion": {"const": "1.0"},
    "type": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,254}$"},
    "subject": {"type": "string", "minLength": 1},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "dataschema": {"type": "string", "minLength": 1},
    "datacontenttype": {"const": "application/json"},
    "profile": {"const": "titect-message/1"},
    "data": {"type": ["array", "boolean", "integer", "null", "number", "object", "string"]},
    "correlationid": {"type": "string", "minLength": 1},
    "causationid": {"type": "string", "minLength": 1}
  }
}
